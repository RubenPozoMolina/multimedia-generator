    "subtitles": [
        { "text": "Intoxicados, medio podridos,", "start": 26.30, "end": 28.5 },
        { "text": "merodean por todas partes,", "start": 28.64, "end": 31.0 },
        { "text": "ensangrentados y malheridos,", "start": 31.40, "end": 34.0 },
        { "text": "muertos infectan las calles.", "start": 34.80, "end": 37.5 },
        { "text": "Puede ser que no sea tan malo,", "start": 38.20, "end": 40.70 },
        { "text": "te lo digo de corazón,", "start": 41.28, "end": 43.42 },
        { "text": "que se extinga toda la especie,", "start": 43.42, "end": 46.80 },
        { "text": "¡¡¡Muertos vivientes!!!", "start": 46.80, "end": 49.20 },
        { "text": "Cuerpos errantes, torpes andantes,", "start": 63.88, "end": 67.02 },
