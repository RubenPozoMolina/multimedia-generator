        { "text": "llagas sangrantes, pieles que caen,", "start": 70.64, "end": 73.0 },
        { "text": "la esperanza ya se perdió.", "start": 73.70, "end": 76.92 },
        { "text": "Puede ser que no sea tan malo,", "start": 76.92, "end": 80.06 },
        { "text": "te lo digo de corazón,", "start": 80.06, "end": 82.5 },
        { "text": "que se extinga toda la especie,", "start": 82.64, "end": 85.60 },
        { "text": "¡¡¡Muertos vivientes!!!", "start": 85.60, "end": 87.96 },
