  "subtitles": [
    { "text": "¡Cerveza, cerveza, quiero cerveza!", "start": 15.18, "end": 16.92 },
    { "text": "Una cerveza bien fría,", "start": 28.68, "end": 30.38 },
    { "text": "pa' quitar el resacón,", "start": 30.38, "end": 31.78 },
    { "text": "si te duele la cabeza", "start": 31.78, "end": 33.36 },
    { "text": "o te duele el corazón.", "start": 33.36, "end": 34.60 },
    { "text": "Un traguito de cerveza,", "start": 34.60, "end": 36.42 },
    { "text": "solo te quita la sed,", "start": 36.42, "end": 37.00 },
    { "text": "si acompaña un canutito,", "start": 37.00, "end": 39.04 },
    { "text": "está más buena de beber.", "start": 39.04, "end": 40.64 },
    { "text": "Una rubia bien fresquita,", "start": 46.92, "end": 50.10 },
    { "text": "y un chupito pa' mezclar,", "start": 50.10, "end": 52.76 },
    { "text": "ahora una de trigo en pinta,", "start": 52.76, "end": 55.88 },
    { "text": "con algo de picar,", "start": 55.88, "end": 58.46 },
    { "text": "una negra sin espuma,", "start": 58.46, "end": 62.02 },
    { "text": "de trago y sin respirar.", "start": 62.02, "end": 64.96 },
    { "text": "Una pinta de cerveza,", "start": 70.54, "end": 72.66 },
    { "text": "con chupito J.D.", "start": 72.66, "end": 73.72 },
    { "text": "se me sube a la cabeza", "start": 73.72, "end": 75.34 },
    { "text": "y me la vuelvo a beber.", "start": 75.34, "end": 76.68 },
    { "text": "No me digas que estás triste,", "start": 76.68, "end": 78.90 },
    { "text": "ven conmigo, siéntate", "start": 78.90, "end": 80.30 },
    { "text": "y tómate una cerveza", "start": 80.30, "end": 81.34 },
    { "text": "que mi amigo va a traer.", "start": 81.34, "end": 82.74 },
    { "text": "Una rubia bien fresquita,", "start": 89.00, "end": 91.88 },
    { "text": "y un chupito pa' mezclar,", "start": 91.88, "end": 94.74 },
    { "text": "ahora una de trigo en pinta,", "start": 94.74, "end": 97.80 },
    { "text": "con algo de picar,", "start": 97.80, "end": 100.64 },
    { "text": "una negra sin espuma,", "start": 100.64, "end": 104.02 },
    { "text": "de trago y sin respirar.", "start": 104.02, "end": 106.86 },
    { "text": "Es famosa en todo el mundo,", "start": 112.70, "end": 114.38 },
    { "text": "tiene razas por doquier,", "start": 114.38, "end": 115.88 },
    { "text": "a la hora de beberla,", "start": 115.88, "end": 117.68 },
    { "text": "a todos les sienta bien.", "start": 117.68, "end": 118.66 },
    { "text": "Vamos todos a brindar,", "start": 119.16, "end": 120.34 },
    { "text": "por un brebaje excepcional,", "start": 120.34, "end": 121.74 },
    { "text": "lo mejor nunca inventado,", "start": 121.74, "end": 123.50 },
    { "text": "que disfrute el personal.", "start": 123.50, "end": 124.60 },
    { "text": "Una rubia bien fresquita,", "start": 130.64, "end": 133.80 },
